# =============================================================================
# ERDDAP settings — the ONE configuration file for every way of running ERDDAP:
#   deploy/prod.sh   production (Docker + HTTPS)
#   docker_run.sh    local development with Docker
#   deploy/local.sh  local development without Docker
# Local scripts reuse these values and override only URLs/ports/email for localhost.
#
# TEMPLATE (committed): cp .env.template .env, then fill in every CHANGE_ME.
# Format: KEY=value, one per line, no quotes, no spaces around "=", no trailing
# comments. A literal "$" must be written as "$$".
# deploy/prod.sh refuses to start while any CHANGE_ME value remains.
# =============================================================================

# --- Public address & HTTPS ---------------------------------------------------
# Domain users will type (no https://, no path). ERDDAP's baseUrl is derived from it.
DOMAIN=erddap.spc.int
# How HTTPS is provided:
#   auto      Caddy container gets/renews a free Let's Encrypt certificate.
#             Needs: DNS for DOMAIN pointing at this server, ports 80+443 open to the internet.
#   certfiles Caddy container uses your own certificate (TLS_CERT_FILE / TLS_KEY_FILE).
#   external  Another reverse proxy (SPC Nginx Proxy Manager / nginx) terminates HTTPS:
#             see deploy/nginx/erddap.spc.int.conf. No Caddy container.
#   internal  Self-signed certificate (testing only).
TLS_MODE=external
# Let's Encrypt account/expiry notices (TLS_MODE=auto)
ACME_EMAIL=CHANGE_ME@spc.int
# Full-chain certificate + private key on this server (TLS_MODE=certfiles)
TLS_CERT_FILE=
TLS_KEY_FILE=
# Host ports for the Caddy container (keep 80/443 for Let's Encrypt)
HTTP_PORT=80
HTTPS_PORT=443

# --- Containers ---------------------------------------------------------------
ERDDAP_IMAGE=erddap/erddap:v2.30.0
CONTAINER_NAME=erddap
# ERDDAP and the Push API also listen here (for the proxy / health checks).
# 0.0.0.0 = reachable by a proxy on another machine or in Docker (firewall 8080/8000 to the proxy only).
# 127.0.0.1 = only a proxy running directly on this host can reach them.
ERDDAP_BIND_ADDRESS=0.0.0.0
ERDDAP_HTTP_PORT=8080

# --- Push API (upload data files at https://DOMAIN/api) -----------------------
# Logins are ERDDAP's own <user> entries in erddap/content/datasets.xml.
# Users with a role listed here may push to every file-based dataset;
# role "push:<datasetID>" grants a single dataset.
PUSH_API_ENABLED=true
PUSH_API_PORT=8000
PUSH_ADMIN_ROLES=spc
PUSH_MAX_UPLOAD_MB=500

# --- Memory -------------------------------------------------------------------
ERDDAP_MIN_MEMORY=2G
ERDDAP_MAX_MEMORY=4G

# --- ERDDAP -------------------------------------------------------------------
ERDDAP_bigParentDirectory=/erddapData/
# Secret used to build dataset reload "flag" URLs. Regenerate: openssl rand -hex 32
ERDDAP_flagKeyKey=CHANGE_ME_run_openssl_rand_hex_32

# --- Email (status reports, dataset failures, subscriptions) ------------------
ERDDAP_emailEverythingTo=CHANGE_ME@spc.int
ERDDAP_emailDailyReportsTo=CHANGE_ME@spc.int
ERDDAP_emailFromAddress=CHANGE_ME@spc.int
ERDDAP_emailUserName=CHANGE_ME@spc.int
ERDDAP_emailPassword=CHANGE_ME
ERDDAP_emailSmtpHost=CHANGE_ME.smtp.server
ERDDAP_emailSmtpPort=587
# pipe-separated key|value pairs
ERDDAP_emailProperties=mail.smtp.starttls.enable|true

# --- Administrator / contact (shown on every page and in dataset metadata) ----
ERDDAP_adminInstitution=Pacific Community (SPC)
ERDDAP_adminInstitutionUrl=https://www.spc.int/
ERDDAP_adminIndividualName=CHANGE_ME
ERDDAP_adminPosition=CHANGE_ME
ERDDAP_adminPhone=CHANGE_ME
ERDDAP_adminAddress=CHANGE_ME
ERDDAP_adminCity=CHANGE_ME
ERDDAP_adminStateOrProvince=CHANGE_ME
ERDDAP_adminPostalCode=CHANGE_ME
ERDDAP_adminCountry=CHANGE_ME
ERDDAP_adminEmail=CHANGE_ME@spc.int
